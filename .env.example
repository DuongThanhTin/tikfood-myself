POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=n8n

API_POSTGRES_USER=tikfood
API_POSTGRES_PASSWORD=tikfood
API_POSTGRES_DB=tikfood
# Leave API_DATABASE_URL empty for Docker Compose so the API container uses api-db.
# For local API execution outside Docker, export:
# DATABASE_URL=postgres://tikfood:tikfood@localhost:15432/tikfood?sslmode=disable
API_DATABASE_URL=

N8N_ENCRYPTION_KEY=change_this_to_a_long_random_string
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

GITHUB_TOKEN=your_github_token_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

AI_AGENT_URL=

NEXT_PUBLIC_API_URL=http://localhost:18081

# --- Authentication (apps/api) — see ADR-0007 ---
# Required in non-dev: a long random secret used to sign access JWTs. Never commit a real value.
JWT_SECRET=
# Token lifetimes (Go duration strings). Defaults: access 15m, refresh 720h (30d).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Set to false only for local http development (refresh cookie needs Secure over https).
COOKIE_SECURE=true
# Browser origin(s) allowed to make credentialed requests. WEB_ORIGIN defaults to the app origin;
# ALLOWED_ORIGINS is an optional comma-separated override list.
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
# Google OAuth SSO (Authorization Code flow). Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:18081/api/v1/auth/google/callback
